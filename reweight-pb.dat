# vim:ft=plumed

# Units and definitions
UNITS LENGTH=A TIME=fs ENERGY=kcal/mol

b1: READ FILE=colvar.out VALUES=b1 IGNORE_FORCES IGNORE_TIME
b2: READ FILE=colvar.out VALUES=b2 IGNORE_FORCES IGNORE_TIME
b3: READ FILE=colvar.out VALUES=b3 IGNORE_FORCES IGNORE_TIME
b4: READ FILE=colvar.out VALUES=b4 IGNORE_FORCES IGNORE_TIME
b5: READ FILE=colvar.out VALUES=b5 IGNORE_FORCES IGNORE_TIME
energy: READ FILE=colvar.out VALUES=energy IGNORE_TIME

metad: PBMETAD ...
  TEMP=300
  ARG=b1,b2,b3,b4,b5
  PF0=b1,b2,b3,b4,b5
  PACE=100
  HEIGHT=0.0
  SIGMA=1
  BIASFACTOR=7
  FILE=hills.out
  GRID_MIN=-5
  GRID_MAX=30
  GRID_SPACING=0.005
  RESTART=YES
...

rw: REWEIGHT_BIAS TEMP=300

PRINT ARG=b1,b2,b3,b4,b5,rw FILE=colvar_reweight.out STRIDE=1

ENDPLUMED

