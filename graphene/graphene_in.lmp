atom_style 	full
units 		real
bond_style      harmonic
angle_style	harmonic
dihedral_style	opls
improper_style  harmonic
pair_style      lj/cut/coul/long 11.0 11.0
pair_modify     mix geometric
special_bonds   lj/coul 0.0 0.0 0.5
neighbor	2.0 bin
timestep 	1
thermo	   	500
kspace_style 	pppm 0.0001

read_data 	equil_bpa_graphene.out 

#---------- CNT ----------

group 		graphene type 1

#---------- Water ----------

group 		water type 2 3

#---------- BPA ------------

molecule 	bpa bpa.mol toff 3 boff 2 aoff 1

group 		bpa type 4 5 6 7 8 9 10 11

#---------- Thermo Variables ----------

variable 	eq_run equal 100000
variable 	pr_run equal 10000000
variable	U equal pe
variable	T equal temp
variable 	P equal press	
variable        t equal time
variable 	step equal step
variable	vol equal vol
variable	a equal cella
variable	b equal cellb
variable	c equal cellc

#---------- Energy minimisation ----------

minimize 	1.0e-4 1.0e-6 1000 1000  
reset_timestep 	0

#---------- Equilibration NVT ----------

fix     	potential all print 500 "${step} ${t} ${U} ${T} ${P} ${vol}" file eq_nvt.out screen no title "step t U T P V"
fix		temperature all nvt temp 300 300 1000

dump    	position all atom 500 eq_nvt.traj
dump_modify 	position sort id 
dump_modify     position scale no

run     	${eq_run}

#---------- Equilibration NPT ----------

unfix   	potential
unfix   	temperature
fix     	potential all print 500 "${step} ${t} ${U} ${T} ${P} ${vol} ${a} ${b} ${c}" file eq_npt.out screen no title "step t U T P V a b c"
fix		temperature all npt temp 300 300 1000 x 1 1 1000 y 1 1 1000 z 1 1 1000 

undump  	position
dump    	position all atom 500 eq_npt.traj
dump_modify 	position sort id
dump_modify     position scale no

run     	${eq_run}

write_data 	equil_bpa_graphene.out 

#---------- Production NPT ----------

unfix   	potential
unfix   	temperature
fix     	potential all print 500 "${step} ${t} ${U} ${T} ${P} ${vol} ${a} ${b} ${c}" file pr_npt.out screen no title "step t U T P V a b c"
fix     	temperature all npt temp 300 300 1000 x 1 1 1000 y 1 1 1000 z 1 1 1000 

undump  	position
dump    	position all atom 500 pr_npt.traj
dump_modify 	position sort id
dump_modify	position scale no

run     ${pr_run}

