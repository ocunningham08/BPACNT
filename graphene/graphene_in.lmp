#---------- Preamble and Data Read ----------

atom_style 	 	full                       # atom ID, molecule ID, atom type, q, x, y, z columns in data file
units 		 	real 			   # mass - g/mol ; distance-Angstrom ; energy-kcal/mol ; time-fs ; temperature-Kelvin ; pressure-atm ; density-g/cm^3
bond_style        	harmonic
angle_style       	harmonic
dihedral_style    	opls
improper_style    	harmonic
pair_style        	lj/cut/coul/long 11.0 11.0 # Lennard Jones with cutoff and Coulomb with long-range solver
pair_modify       	mix geometric		   
special_bonds     	lj/coul 0.0 0.0 0.5
kspace_style      	pppm 0.0001                # Long-range solver
neighbor	  	2.0 bin		
timestep 	  	1			   # fs
thermo	   	  	500  			   # How often to print to lmp.out

read_data		equil_bpa_graphene.out


#---------- Molecule set up ----------

group 			bpa type 2 3 4 5 6 7 8 9

group 			water type 10 11

#---------- Variables ----------

include			variables.lmp

#---------- Energy minimisation ----------

minimize 		1.0e-4 1.0e-6 1000 1000  
reset_timestep 		0
write_data 		start.data

#---------- Equilibration NVT ----------

fix     		potential all print 500 "${step} ${t} ${U} ${T} ${P} ${vol} ${den}" file eq_nvt.out screen no title "# t U T P V density"
fix			temperature all nvt temp 300 300 1000

dump    		position all atom 500 eq_nvt.traj

dump_modify     	position sort id
dump_modify		position scale no
dump_modify		position image no

run     		${eq_run}

#---------- Equilibration NPT ----------

unfix   		potential
unfix   		temperature

fix     		potential all print 500 "${step} ${t} ${U} ${T} ${P} ${vol} ${den} ${a} ${b} ${c}" file eq_npt.out screen no title "# t U T P V density a b c"
fix			temperature all npt temp 300 300 1000 x 1 1 1000 y 1 1 1000 z 1 1 1000 couple xy

undump  		position

dump    		position all atom 500 eq_npt.traj
dump_modify     	position sort id
dump_modify             position scale no
dump_modify             position image no

run     		${eq_run}

#---------- Production run NPT ----------

unfix   		potential
unfix   		temperature

fix     		potential all print 500 "${step} ${t} ${U} ${T} ${P} ${vol} ${den} ${a} ${b} ${c}" file pr_npt.out screen no title  "# t U T P V density a b c"
fix			temperature all npt temp 300 300 1000 x 1 1 1000 y 1 1 1000 z 1 1 1000 couple xy

undump  		position

dump    		position all atom 500 pr_npt.traj
dump_modify     	position sort id
dump_modify             position scale no
dump_modify             position image no

reset_timestep 		0
restart 		500000 tmp-2.restart tmp-1.restart

run 			${pr_run}

write_data		final.data
