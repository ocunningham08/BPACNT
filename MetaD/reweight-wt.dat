# vim:ft=plumed

# Units and definitions
UNITS LENGTH=A TIME=fs ENERGY=kcal/mol

bias_cv: READ FILE=colvar.out VALUES=bias_cv IGNORE_FORCES IGNORE_TIME
energy: READ FILE=colvar.out VALUES=energy IGNORE_TIME

metad: METAD ...
  TEMP=300 
  ARG=bias_cv
  PACE=100 
  HEIGHT=0.0
  SIGMA=1 
  BIASFACTOR=7
  FILE=hills.out
  GRID_MIN=-5
  GRID_MAX=30
  GRID_SPACING=0.005
  RESTART=YES
...

rw: REWEIGHT_BIAS TEMP=300

hhh: HISTOGRAM ...
  ARG=bias_cv STRIDE=1
  GRID_MIN=-15 GRID_MAX=30 GRID_SPACING=0.005 
  LOGWEIGHTS=rw CLEAR=10000 KERNEL=DISCRETE
...

#fes: CONVERT_TO_FES GRID=hhh TEMP=300
DUMPGRID GRID=hhh FILE=hist.dat STRIDE=19875

PRINT ARG=bias_cv,rw FILE=colvar_reweight.out STRIDE=1

ENDPLUMED
