#---------- Preamble and Data Read ----------

atom_style 	 	full                       # atom ID, molecule ID, atom type, q, x, y, z columns in data file
units 		 	real 			   # mass - g/mol ; distance-Angstrom ; energy-kcal/mol ; time-fs ; temperature-Kelvin ; pressure-atm ; density-g/cm^3
bond_style        	harmonic
angle_style       	harmonic
dihedral_style    	opls
improper_style    	harmonic
pair_style        	lj/cut/coul/long 11.0 11.0 # Lennard Jones with cutoff and Coulomb with long-range solver
pair_modify       	mix geometric		   
special_bonds     	lj/coul 0.0 0.0 0.5
kspace_style      	pppm 0.0001                # Long-range solver
neighbor	  	2.0 bin		
timestep 	  	1			   # fs
thermo	   	  	500  			   # How often to print to lmp.out

read_data 		input.data extra/atom/types 10 extra/bond/types 8 extra/angle/types 11 extra/dihedral/types 15 extra/improper/types 1 extra/bond/per/atom 15 extra/angle/per/atom 15 extra/dihedral/per/atom 50 extra/improper/per/atom 50 extra/special/per/atom 100 
include 		params.lmp

#---------- Molecule set up ----------

molecule 		bpa bpa.mol toff 1 boff 1 doff 1 ioff 1 
group 			bpa type 2 3 4 5 6 7 8 9

molecule 		water water.mol toff 9 boff 8 aoff 10
group 			water type 10 11

#---------- Create atoms ----------

region 			cnt cylinder z 40 40 9 0 61.352 side out     				# Inner tube surrounding CNT
region 			bpa cylinder z 40 40 14 0 61.352 side in     				# Outer tube surrounding CNT
region 			tube intersect 2 cnt bpa		     				# Defines area between the tubes

variable		nbpa equal 1								# Number of BPA
variable 		wrho equal 0.997 							# experimental density of water
variable 		R equal 9 								# Exluded cylinder radius
variable		NA equal 6.02214076e23 							# Avogadro's Number
variable 		Nwater_noBPA equal floor(v_wrho*(lx*ly*lz-PI*v_R^2*lz)*1.0e-24*v_NA/18) # Number of water that would fit at experimental density if there was no BPA
variable		Nwater equal v_Nwater_noBPA-(v_nbpa*10) 				# Remove enough water for the BPA

create_atoms 		0 random ${nbpa} 42 tube mol bpa 42 overlap 2 maxtry 100
create_atoms 		0 random ${Nwater} 42 cnt mol water 42 overlap 1.5 maxtry 200

#---------- Set velocities ----------

velocity		all create 300 903723

#---------- Variables ----------

include			variables.lmp

#---------- Energy minimisation ----------

minimize 		1.0e-4 1.0e-6 1000 1000  
reset_timestep 		0
write_data 		start.data

#---------- Equilibration NVT ----------

fix     		potential all print 500 "${step} ${t} ${U} ${T} ${P} ${vol} ${den}" file eq_nvt.out screen no title "# t U T P V density"
fix			temperature all nvt temp 300 300 1000

dump    		position all atom 500 eq_nvt.traj

dump_modify     	position sort id
dump_modify		position scale no
dump_modify		position image no

run     		${eq_run}

#---------- Equilibration NPT ----------

unfix   		potential
unfix   		temperature

fix     		potential all print 500 "${step} ${t} ${U} ${T} ${P} ${vol} ${den} ${a} ${b} ${c}" file eq_npt.out screen no title "# t U T P V density a b c"
fix			temperature all npt temp 300 300 1000 x 1 1 1000 y 1 1 1000 z 1 1 1000 couple xy

undump  		position

dump    		position all atom 500 eq_npt.traj
dump_modify     	position sort id
dump_modify             position scale no
dump_modify             position image no

run     		${eq_run}

#---------- Production run NPT ----------

unfix   		potential
unfix   		temperature

fix     		potential all print 500 "${step} ${t} ${U} ${T} ${P} ${vol} ${den} ${a} ${b} ${c}" file pr_npt.out screen no title  "# t U T P V density a b c"
fix			temperature all npt temp 300 300 1000 x 1 1 1000 y 1 1 1000 z 1 1 1000 couple xy

undump  		position

dump    		position all atom 500 pr_npt.traj
dump_modify     	position sort id
dump_modify             position scale no
dump_modify             position image no

reset_timestep 		0
restart 		500000 tmp-2.restart tmp-1.restart

run 			${pr_run}

write_data		final.data
